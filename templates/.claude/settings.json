{
  "permissions": {
    "deny": [
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(.claude/**)",
      "Edit(.env*)",
      "Read(.env*)",
      "Edit(theodolite.toml)",
      "Bash(* > theodolite.toml*)",
      "Bash(* >> theodolite.toml*)",
      "Bash(cp * theodolite.toml*)",
      "Bash(mv * theodolite.toml*)"
    ],
    "ask": [
      "Edit(**/migrations/**)",
      "Edit(**/*.prisma)",
      "Edit(**/drizzle/**)",
      "Edit(**/alembic/**)",
      "Edit(**/auth/**)",
      "Edit(**/auth.ts)",
      "Edit(**/middleware.ts)",
      "Edit(**/proxy.ts)",
      "Edit(.github/**)",
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm add *)",
      "Bash(pnpm add *)",
      "Bash(pnpm install *)",
      "Bash(pnpm i *)",
      "Bash(yarn add *)",
      "Bash(bun add *)",
      "Bash(bun install *)",
      "Bash(bun i *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(python -m pip install *)",
      "Bash(poetry add *)",
      "Bash(uv add *)",
      "Bash(npm publish *)",
      "Bash(npm run deploy *)",
      "Bash(npm run migrate *)",
      "Bash(npx prisma migrate *)",
      "Bash(npx prisma db *)",
      "Bash(prisma db *)",
      "Bash(pnpm prisma *)",
      "Bash(yarn prisma *)",
      "Bash(bunx prisma *)",
      "Bash(npx drizzle-kit push *)",
      "Bash(npx drizzle-kit migrate *)",
      "Bash(drizzle-kit push *)",
      "Bash(drizzle-kit migrate *)",
      "Bash(npx supabase db *)",
      "Bash(supabase db *)",
      "Bash(psql *)",
      "Bash(alembic upgrade *)",
      "Bash(vercel deploy *)",
      "Bash(fly deploy *)",
      "Bash(kubectl apply *)",
      "Bash(terraform apply *)"
    ]
  },
  "hooks": {
    "Stop": [
      { "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && npx theodolite@${version} status", "timeout": 20 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && npx theodolite@${version} status", "timeout": 20 }] }
    ]
  }
}
