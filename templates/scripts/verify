#!/bin/sh
# Runs typecheck, lint and targeted tests when the project has them. Edit freely.
# Usage: scripts/verify [test paths...]
fail() { echo "verify: FAILED at $1"; exit 1; }
run() { name=$1; shift; echo "verify: $name"; "$@" || fail "$name"; }
has_script() { [ -f package.json ] && grep -q "\"$1\"[[:space:]]*:" package.json; }

ran=0
if [ -f package.json ]; then
  has_script typecheck && { run typecheck npm run --silent typecheck; ran=1; }
  has_script lint && { run lint npm run --silent lint; ran=1; }
  if has_script test; then
    if [ $# -gt 0 ]; then run test npm test --silent -- "$@"; else run test npm test --silent; fi
    ran=1
  fi
fi
if [ -f pyproject.toml ]; then
  command -v mypy >/dev/null 2>&1 && { run mypy mypy .; ran=1; }
  command -v ruff >/dev/null 2>&1 && { run ruff ruff check .; ran=1; }
  command -v pytest >/dev/null 2>&1 && { run pytest pytest -q "$@"; ran=1; }
fi
[ "$ran" = 1 ] || echo "verify: nothing to run; add typecheck, lint or test scripts"
echo "verify: ok"
